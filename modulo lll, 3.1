#!/bin/bash
# ===========================================
# Script: backup_home.sh
# Descripción: Crea un archivo comprimido (.tar.gz)
#              del directorio /home/zammyl con la
#              fecha y hora actual en el nombre.
# Autor: Zammyl
# Fecha: $(date '+%d-%m-%Y %H:%M')
# ===========================================

# Variables
USUARIO="zammyl"
FECHA=$(date '+%d-%m-%Y_%H-%M')
DESTINO="/home/$USUARIO/backups"
ARCHIVO="backup_${FECHA}.tar.gz"

# Crear carpeta de backups si no existe
mkdir -p "$DESTINO"

# Crear el comprimido con tar
tar -czvf "$DESTINO/$ARCHIVO" "/home/$USUARIO"

# Mensaje final
echo "✅ Backup creado exitosamente: $DESTINO/$ARCHIVO"
